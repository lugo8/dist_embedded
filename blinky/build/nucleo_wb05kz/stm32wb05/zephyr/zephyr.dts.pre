/ {
 arduino_header: connector {
  compatible = "arduino-header-r3";
  #gpio-cells = <2>;
  gpio-map-mask = <0xffffffff 0xffffffc0>;
  gpio-map-pass-thru = <0 0x3f>;





  gpio-map = <14 0 &gpiob 15 0>,
      <16 0 &gpioa 9 0>,
      <17 0 &gpioa 11 0>,
      <18 0 &gpioa 8 0>,
      <19 0 &gpiob 3 0>,
      <20 0 &gpiob 7 0>,
      <21 0 &gpiob 6 0>;
 };
};

arduino_i2c: &i2c1 {};

arduino_serial: &usart1 {};

arduino_spi: &spi3 {};
# 13 "C:/Users/biote/OneDrive/Documents/zephyr/external/zephyr/boards/st/nucleo_wb05kz/nucleo_wb05kz.dts" 2

/ {
 model = "STMicroelectronics STM32WB05KZ-NUCLEO board";
 compatible = "st,stm32wb05kz-nucleo";

 #address-cells = <1>;
 #size-cells = <1>;

 chosen {
  zephyr,console = &usart1;
  zephyr,shell-uart = &usart1;
  zephyr,sram = &sram0;
  zephyr,flash = &flash0;
  zephyr,bt-c2h-uart = &usart1;
 };

 leds: leds {
  compatible = "gpio-leds";

  blue_led_1: led_0 {
   gpios = <&gpiob 1 ((1 << 0) | (1 << 4))>;
  };

  green_led_1: led_1 {
   gpios = <&gpiob 4 ((1 << 0) | (1 << 4))>;
  };

  red_led_1: led_2 {
   gpios = <&gpiob 2 ((1 << 0) | (1 << 4))>;
  };
 };

 pwmleds: pwmleds {
  compatible = "pwm-leds";
  status = "okay";

  pwm_red_led_1: pwm_led_1 {
   pwms = <&pwm2 3 (((20) * 1000UL) * 1000UL) (0 << 0)>;
  };
 };

 gpio_keys {
  compatible = "gpio-keys";

  user_button_1: button_0 {
   label = "SW1";
   gpios = <&gpioa 0 ((1 << 0) | (1 << 4))>;
   zephyr,code = <11>;
  };

  user_button_2: button_1 {
   label = "SW2";
   gpios = <&gpiob 5 ((1 << 0) | (1 << 4))>;
   zephyr,code = <2>;
  };

  user_button_3: button_2 {
   label = "SW3";
   gpios = <&gpiob 14 ((1 << 0) | (1 << 4))>;
   zephyr,code = <3>;
  };
 };

 aliases {
  rtc = &rtc;
  led0 = &blue_led_1;
  led1 = &green_led_1;
  led2 = &red_led_1;
  pwm-led0 = &pwm_red_led_1;
  sw0 = &user_button_1;
  sw1 = &user_button_2;
  sw2 = &user_button_3;
  watchdog0 = &iwdg;
 };
};

&pwrc {
 smps-mode = "RUN";
 smps-bom = <3>;
};

&clk_lse {
 status = "okay";
};

&clk_hse {
 status = "okay";
};

&clk_hsi {
 status = "okay";
};

&pll {
 status = "okay";
};

&rcc {
 clocks = <&pll>;
 clock-frequency = <(((64) * 1000) * 1000)>;
 clksys-prescaler = <1>;
 slow-clock = <&clk_lse>;
};

&rtc {




 clocks = <&rcc (0x54) (1 << 12)>,
   <&rcc 0x002 0xFF>;
 status = "okay";
};

&iwdg {
 status = "okay";
};

&bt_hci_wb0 {
 status = "okay";
};

&radio_timer {
 status = "okay";
};

&usart1 {
 pinctrl-0 = <&usart1_tx_pa1 &usart1_rx_pb0>;
 pinctrl-names = "default";
 current-speed = <115200>;
 status = "okay";
};

&i2c1 {
 pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
 pinctrl-names = "default";
 status = "okay";
};

&spi3 {
 pinctrl-0 = <&spi3_nss_pa9 &spi3_sck_pb3 &spi3_miso_pa8 &spi3_mosi_pa11>;
 pinctrl-names = "default";
 status = "okay";

 clocks = <&rcc (0x58) (1 << 14)>,
   <&rcc 0x001 ((((0x08) & 0xFFFFU) << 0U) | (((22) & 0x1FU) << 16U) | ((((23) - (22)) & 0x3U) << 21U) | ((((3)) & 0xFFU) << 24U))>;
};

&timers2 {
 status = "okay";
 st,prescaler = <10000>;

 pwm2: pwm {

  pinctrl-0 = <&tim2_ch3_pb2>;
  pinctrl-names = "default";
  status = "okay";
 };
};

&rng {
 status = "okay";
};

&flash0 {
 partitions {
  compatible = "fixed-partitions";
  #address-cells = <1>;
  #size-cells = <1>;


  storage_partition: partition@2e000 {
   label = "storage";
   reg = <0x0002e000 ((8) * 1024)>;
  };
 };
};
