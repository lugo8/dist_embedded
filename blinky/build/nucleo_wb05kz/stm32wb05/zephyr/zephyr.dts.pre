     };
    };
   };
  };

  timers2: timers@40002000 {
   compatible = "st,stm32-timers";
   reg = <0x40002000 ((1) * 1024)>;
   clocks = <&rcc (0x54) (1 << 0)>,
     <&rcc 0x001 0xFF>;
   resets = <&rctl (((0x34) << 5U) | (0))>;
   interrupts = <10 0>;
   interrupt-names = "global";
   st,prescaler = <0>;
   status = "disabled";

   pwm {
    compatible = "st,stm32-pwm";
    status = "disabled";
    #pwm-cells = <3>;
   };

   counter {
