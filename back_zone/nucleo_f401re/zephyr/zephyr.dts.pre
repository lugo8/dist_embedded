&pinctrl {
 uart1_default: uart1_default {
  group1 {
   pinmux = <(((21 & 0x3FU) << 0U) | ((0x1FFU & 0x1FFU) << 6U) | ((9 & 0x1FFU) << 15U))>;
   output-high;
  };

  group2 {
   pinmux = <(((20 & 0x3FU) << 0U) | ((9 & 0x1FFU) << 6U) | ((0x1FFU & 0x1FFU) << 15U))>;
   bias-pull-up;
  };
 };

 spim2_default: spim2_default {
  group1 {
   pinmux = <(((8 & 0x3FU) << 0U) | ((64 & 0x1FFU) << 6U) | ((0x1FFU & 0x1FFU) << 15U))>,
     <(((10 & 0x3FU) << 0U) | ((0x1FFU & 0x1FFU) << 6U) | ((63 & 0x1FFU) << 15U))>;
  };

  group2 {
   pinmux = <(((7 & 0x3FU) << 0U) | ((0x1FFU & 0x1FFU) << 6U) | ((65 & 0x1FFU) << 15U))>;
   output-low;
  };
 };

 i2c0_default: i2c0_default {
  group1 {
   pinmux = <(((5 & 0x3FU) << 0U) | ((54 & 0x1FFU) << 6U) | ((54 & 0x1FFU) << 15U))>,
     <(((6 & 0x3FU) << 0U) | ((53 & 0x1FFU) << 6U) | ((53 & 0x1FFU) << 15U))>;
   bias-pull-up;
   drive-open-drain;
   output-high;
  };
 };
};
