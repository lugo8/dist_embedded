/ {
 aliases {
  can-a = &can_a;
  can-b = &can_b;
 };


 blinkers {
  compatible = "gpio-leds";
  fl: fl { gpios = <&gpiod 2 (0 << 0)>; };
  fr: fr { gpios = <&gpioc 11 (0 << 0)>; };
 };

 zephyr,user {

  pwms = <&servo_pwm 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;


  tp-relay-tx-gpios = <&gpioc 8 (0 << 0)>;

  tp-err-gpios = <&gpioa 15 (0 << 0)>;
  can-a-degraded-gpios = <&gpioc 10 (0 << 0)>;
  can-b-degraded-gpios = <&gpioc 12 (0 << 0)>;
  can-a-rx-gpios = <&gpiob 8 (0 << 0)>;
  can-b-rx-gpios = <&gpiob 9 (0 << 0)>;
  can-a-tx-gpios = <&gpioa 0 (0 << 0)>;
  can-b-tx-gpios = <&gpioa 1 (0 << 0)>;
 };
};


&i2c3 { status = "disabled"; };


&i2c1 { status = "disabled"; };
&usart2 { status = "okay"; };



&timers1 {
 status = "okay";
 st,prescaler = <83>;

 servo_pwm: pwm {
  pinctrl-0 = <&tim1_ch1_pa8>;
  pinctrl-names = "default";
  status = "okay";
 };
};



&spi1 {
 status = "okay";

 cs-gpios = <&gpiob 6 ((1 << 0) | (1 << 4))>,
     <&gpioc 7 ((1 << 0) | (1 << 4))>;

 can_a: mcp2515@0 {
  compatible = "microchip,mcp2515";
  reg = <0>;
  spi-max-frequency = <1000000>;
  int-gpios = <&gpioa 10 (1 << 0)>;
  osc-freq = <16000000>;
  bitrate = <500000>;
  status = "okay";
 };

 can_b: mcp2515@1 {
  compatible = "microchip,mcp2515";
  reg = <1>;
  spi-max-frequency = <1000000>;
  int-gpios = <&gpiob 5 (1 << 0)>;
  osc-freq = <16000000>;
  bitrate = <500000>;
  status = "okay";
 };
};
# 0 "<command-line>" 2
# 1 "C:/Users/biote/Documents/dist_embedded/dist_embedded/external/zephyr/misc/empty_file.c"
