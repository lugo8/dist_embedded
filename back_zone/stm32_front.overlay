/*
 * STM32 back (drivetrain zone) on nucleo_f401re.
 *
 * CAN SPI and chip-select pins match the front board. PA13/PA14 are reserved
 * for SWD. RL/RR use PC8/PB0 and avoid the error indicator on PA15. PA8
 * provides the shared motor PWM signal for both H-bridges.
 */
/ {
	aliases {
		can-a = &can_a;
		can-b = &can_b;
	};

	rear_lights {
		compatible = "gpio-leds";
		rl: rl { gpios = <&gpioc 8 GPIO_ACTIVE_HIGH>; };   /* PC8 */
		rr: rr { gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>; };   /* PB0 */
	};

	zephyr,user {
		pwms = <&motor_pwm 1 PWM_USEC(100) PWM_POLARITY_NORMAL>;

		tp-pwm-set-gpios = <&gpioc 11 GPIO_ACTIVE_HIGH>;    /* PC11 */
		dir-a-gpios = <&gpioc 9 GPIO_ACTIVE_HIGH>;          /* PC9 */
		dir-b-gpios = <&gpiob 12 GPIO_ACTIVE_HIGH>;         /* PB12 */
		tp-err-gpios = <&gpioa 15 GPIO_ACTIVE_HIGH>;        /* PA15 */
		can-a-degraded-gpios = <&gpioc 10 GPIO_ACTIVE_HIGH>; /* PC10 */
		can-b-degraded-gpios = <&gpioc 12 GPIO_ACTIVE_HIGH>; /* PC12 */
		can-a-rx-gpios = <&gpioc 0 GPIO_ACTIVE_HIGH>;        /* PC0 */
		can-b-rx-gpios = <&gpioc 1 GPIO_ACTIVE_HIGH>;        /* PC1 */
		can-a-tx-gpios = <&gpioc 2 GPIO_ACTIVE_HIGH>;        /* PC2 */
		can-b-tx-gpios = <&gpioc 3 GPIO_ACTIVE_HIGH>;        /* PC3 */
	};
};

/* Free the pins used for encoder feedback and motor PWM. */
&i2c3 { status = "disabled"; };
&i2c1 { status = "disabled"; };
&usart1 { status = "disabled"; };
&adc1 { status = "disabled"; };
&pwm2 { status = "disabled"; };
&usart2 { status = "okay"; };

/* Left encoder on PA0/PA1. */
&timers2 {
	status = "okay";

	enc_left: qdec {
		pinctrl-0 = <&tim2_ch1_pa0 &tim2_ch2_pa1>;
		pinctrl-names = "default";
		st,encoder-mode = <0x3>;
		st,input-filter-level = <10>;
		st,counts-per-revolution = <1>;
		status = "okay";
	};
};

/* Right encoder on PB4/PB5. CAN B interrupt is moved to PC4 to free PB5. */
&timers3 {
	status = "okay";

	enc_right: qdec {
		pinctrl-0 = <&tim3_ch1_pb4 &tim3_ch2_pb5>;
		pinctrl-names = "default";
		st,encoder-mode = <0x3>;
		st,input-filter-level = <10>;
		st,counts-per-revolution = <1>;
		status = "okay";
	};
};

&tim2_ch1_pa0 { bias-pull-up; };
&tim2_ch2_pa1 { bias-pull-up; };
&tim3_ch1_pb4 { bias-pull-up; };
&tim3_ch2_pb5 { bias-pull-up; };

/* TIM1_CH1/PA8 is the shared 10 kHz motor PWM output. */
&timers1 {
	status = "okay";
	st,prescaler = <83>;

	motor_pwm: pwm {
		pinctrl-0 = <&tim1_ch1_pa8>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&spi1 {
	status = "okay";
	cs-gpios = <&gpiob 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
		   <&gpioc 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

	can_a: mcp2515@0 {
		compatible = "microchip,mcp2515";
		reg = <0>;
		spi-max-frequency = <1000000>;
		int-gpios = <&gpioa 10 GPIO_ACTIVE_LOW>;  /* D2 */
		osc-freq = <16000000>;
		bitrate = <500000>;
		status = "okay";
	};

	can_b: mcp2515@1 {
		compatible = "microchip,mcp2515";
		reg = <1>;
		spi-max-frequency = <1000000>;
		int-gpios = <&gpioc 4 GPIO_ACTIVE_LOW>;    /* PC4 */
		osc-freq = <16000000>;
		bitrate = <500000>;
		status = "okay";
	};
};
